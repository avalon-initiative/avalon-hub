{
  "name": "@avalon/hub",
  "private": true,
  "version": "0.1.0",
  "description": "Avalon Hub — the web client and first doorway into Avalon Protocol: identity setup, friends, guilds, guild chat, achievements. A client only; it holds no protocol state of its own and talks to avalon-server over HTTP/WebSocket.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "dependencies": {
    "@avalon-initiative/common-ui": "0.1.3",
    "@avalon-initiative/protocol-sdk": "0.1.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "pinia": "^4.1.0",
    "@simplewebauthn/browser": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "sass": "^1.106.1",
    "typescript": "^5.6.0",
    "vue-tsc": "^3.3.13",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "jsdom": "^30.1.3"
  }
}
